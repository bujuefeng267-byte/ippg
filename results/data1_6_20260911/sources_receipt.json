                "label": "waveform_replay_qa.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "心率误差",
                "definition": "MAE 和 RMSE 在程序有效输出且参考合格的相同10秒窗口计算，单位bpm。"
              },
              {
                "label": "±5 bpm占比",
                "definition": "P5的分母为有效配对输出窗口；R5的分母为所有参考合格的计划窗口，缺失输出计入失败。"
              },
              {
                "label": "输出覆盖率",
                "definition": "心率覆盖率为接受窗口/计划窗口；波形覆盖率为有限数值样本/完整解码帧数。"
              }
            ],
            "filters": [
              "六段完整录像",
              "V2.4 guarded_fusion、tracking_screened、gap 0.10秒",
              "10秒窗口、约1秒步长、离线DP心率"
            ],
            "caveats": [
              "视频与Polar按原始文件时间估计同步，尚非硬件同步；预定七个偏移未按误差挑选。",
              "波形覆盖不等于波形形态准确；重叠窗口和重复录制不等于独立受试者。",
              "本次核心算法未修改，不是版本升级对比。"
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "保存结果回算",
                "detail": "六段共18条保存波形的局部心率与DP心率独立回算均通过；此检查证明结果与处理规则一致，不证明生理测量准确。"
